{
  "compilerOptions": {
    "target": "ES2021",               
    "module": "CommonJS",              
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,                  
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "resolveJsonModule": true          
  },
  "include": ["src/**/*"]
}