CREATE TABLE `anggota` (
  `id` bigint UNSIGNED NOT NULL,
  `litabmas_id` char(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'FK ke litabmas.id',
  `nama` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nama anggota',
  `jenis` enum('Dosen','Mahasiswa','Profesional/Mitra') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Jenis anggota',
  `id_sdm` char(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'ID Dosen (jika jenis=Dosen)',
  `id_peserta_didik` char(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'ID mahasiswa (jika jenis=Mahasiswa)',
  `nomor_induk_peserta_didik` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'NIM (jika jenis=Mahasiswa)',
  `id_orang` char(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'ID kolaborator luar (jika jenis lain)',
  `aktif` tinyint(1) NOT NULL DEFAULT '1' COMMENT '1=aktif, 0=tidak aktif',
  `peran` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Ketua atau Anggota'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

