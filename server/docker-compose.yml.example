version: '3.8'

services:
  mysql-db:
    image: mysql:8.0
    container_name: database_sippm
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: 
      MYSQL_DATABASE: lppm_db              
      MYSQL_USER:              
      MYSQL_PASSWORD:      
    ports:
      - "3306:3306"                         
    volumes:
      - mysql_data:/var/lib/mysql     
      - ./src/database:/docker-entrypoint-initdb.d 
      
  phpmyadmin:
    image: phpmyadmin/phpmyadmin
    container_name: phpmyadmin_sippm
    restart: always
    ports:
      - "8080:80"
    environment:
      PMA_HOST: mysql-db 
      PMA_PORT: 3306
    depends_on:
      - mysql-db     

volumes:
  mysql_data: